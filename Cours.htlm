    <!-- Contenu Principal -->
    <main style="max-width: 900px; margin: 30px auto; padding: 0 20px;">

        <!-- Section Document Physique-Chimie -->
        <section style="background: white; padding: 25px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.05); margin-bottom: 30px;">
